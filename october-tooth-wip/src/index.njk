{% set t = collections.tapes[0].data %}
<div class="home-hero" style="background-image: url('{{ homeImage }}');" role="img" aria-label="{{ homeImageAlt }}">
  <div class="home-panel">
    <div class="home-panel-bar">october tooth</div>
    <div class="home-panel-body">
      <p class="home-tagline">music, art, and other things from october tooth.</p>

      <ul class="home-links">
        {% if t %}
        <li><a href="/tapes/{{ t.slug }}/">cassette tapes</a></li>
        {% else %}
        <li class="home-empty">cassette tapes — coming soon</li>
        {% endif %}
        <li><a href="https://open.spotify.com/artist/1vwb2e3nTwu2n2eDVGRFeu" target="_blank" rel="noopener">spotify</a></li>
        <li><a href="https://music.apple.com/us/artist/october-tooth/1051012459" target="_blank" rel="noopener">apple music</a></li>
        <li><a href="https://octobertooth.bandcamp.com/" target="_blank" rel="noopener">bandcamp</a></li>
        <li><a href="https://on.soundcloud.com/mA0rHAlNXnDysiI1Yd" target="_blank" rel="noopener">soundcloud</a></li>
        <li><a href="https://youtube.com/@octobertooth" target="_blank" rel="noopener">youtube</a></li>
        <li><a href="/shop/">shop</a></li>
        <li><a href="/shows/">shows</a></li>
        <li><a href="/archive/">archive</a></li>
      </ul>
      <p class="home-about-link"><a href="/about/">about</a></p>
    </div>
  </div>
</div>
