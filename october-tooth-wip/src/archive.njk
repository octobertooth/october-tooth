---
layout: layouts/base.njk
permalink: /archive/
title: "archive — october tooth"
bareChrome: true
---
<div class="archive-list">
  {% for tape in collections.tapes %}
  <a class="archive-row" href="{% if loop.first %}/{% else %}/tapes/{{ tape.data.slug }}/{% endif %}">
    <span class="archive-main">
      <span class="archive-num">{{ tape.data.tapeNumber | pad3 }}</span>
      <span class="archive-title">{{ tape.data.title }}</span>
    </span>
    <span class="archive-date">{{ tape.data.date | readableDate }}</span>
  </a>
  {% else %}
  <p class="archive-empty">nothing here yet.</p>
  {% endfor %}
</div>
