---
layout: layouts/base.njk
permalink: /archive/
title: "archive — october tooth"
---
<div class="archive-list">
  {% for tape in collections.tapes %}
  <a class="archive-row" href="/tapes/{{ tape.data.slug }}/">
    <span><span class="archive-num">{{ tape.data.tapeNumber | pad3 }}</span>{{ tape.data.title }}</span>
    <span>{{ tape.data.date | readableDate }}</span>
  </a>
  {% else %}
  <p>nothing here yet.</p>
  {% endfor %}
</div>
