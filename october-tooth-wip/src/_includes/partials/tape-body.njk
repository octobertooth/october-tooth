{% import "partials/media-caption.njk" as cap %}
{% set headerWidths = [640, 960, 1280, 1600, 1920] %}
{% set headerSet = t.headerImage | cdnSet(headerWidths) %}

{% if t.headerImage %}
<div class="header-image">
  <img
    src="{{ t.headerImage | cdn(1600) }}"
    {% if headerSet %}srcset="{{ headerSet }}" sizes="(max-width: 860px) 100vw, 860px"{% endif %}
    alt="{{ t.headerAlt or '' }}"
    width="1600" height="900"
    fetchpriority="high" decoding="async" />
</div>
{% endif %}

<div class="tape-meta">
  <div class="tape-date">{{ t.date | readableDate }} <span aria-hidden="true">&middot;</span> tape no. {{ t.tapeNumber | pad3 }}</div>
  <h1 class="tape-title">{{ t.title }}</h1>
</div>

<section class="deck" data-deck aria-label="tape deck">
  <div class="deck-plate">
    <div class="deck-top">
      <div class="deck-cue">
        <div class="deck-state">
          <span class="dot" data-state-dot aria-hidden="true"></span>
          <span class="deck-word" data-deck-state>cued</span>
          <span class="np" data-sticker role="status" aria-live="polite">
            <svg class="np-reel" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="12" cy="12" r="9.25" fill="none" stroke="currentColor" stroke-width="1.4" />
              <circle cx="12" cy="12" r="2.4" fill="currentColor" />
              <path d="M12 16.2V20.2M8.36 9.9 4.9 7.9M15.64 9.9 19.1 7.9"
                    fill="none" stroke="currentColor" stroke-width="1.4" />
            </svg>
            <span class="np-name" data-sticker-track></span>
          </span>
        </div>

        <p class="deck-track" data-cass-title>{{ t.tracks[0].title if t.tracks else 'no tape loaded' }}</p>
        <p class="deck-of">side a <span aria-hidden="true">&middot;</span> tape no. {{ t.tapeNumber | pad3 }}</p>
      </div>

      <div class="deck-clock">
        <span class="deck-elapsed" data-counter>00:00</span>
        <span class="deck-len">of <span data-total>00:00</span></span>
        <span class="deck-flag" data-lamp="demo">no file<span class="sr-only">
          for this track — the transport is running against the printed time</span></span>
      </div>
    </div>

    <div class="scrub-wrap">
      <input class="scrub" type="range" data-seek min="0" max="1000" step="1" value="0"
             aria-label="position in track" />
    </div>

    <div class="deck-controls">
      <div class="transport">
        <button class="key key--play" type="button" data-act="play" aria-label="play">
          <span class="key-glyph" aria-hidden="true">&#9656;</span><span class="key-legend" data-play-legend>play</span>
        </button>
        <button class="key" type="button" data-act="stop" aria-label="stop">
          <span class="key-glyph" aria-hidden="true">&#9632;</span><span class="key-legend">stop</span>
        </button>
      </div>

      <label class="level">
        <span class="level-key">level</span>
        <input class="scrub" type="range" data-level min="0" max="1" step="0.01" value="0.85" aria-label="level" />
      </label>
    </div>
  </div>

  {% if t.tracks %}
  <div class="tape-contents">
    <div class="contents-key">
      <span>tape contents</span>
      <span>{{ t.tracks | length }} {{ 'track' if t.tracks | length == 1 else 'tracks' }}</span>
    </div>
    <ul class="tracklist">
      {% for track in t.tracks %}
      <li>
        <button class="track{% if loop.first %} is-cued{% endif %}" type="button"
                data-track data-src="{{ track.audio | audioSrc(t.slug) }}" data-seconds="{{ track.duration | seconds }}"
                data-title="{{ track.title }}" aria-pressed="{{ 'true' if loop.first else 'false' }}">
          <span class="dot{% if loop.first %} is-on{% endif %}" aria-hidden="true"></span>
          <span class="track-no">{{ loop.index | pad2 }}</span>
          <span class="track-title">{{ track.title }}</span>
          <span class="track-duration">{{ track.duration }}</span>
        </button>
      </li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}
</section>

{% if t.wavDownload or t.bandcamp or t.soundcloud %}
<div class="listen-links">
  {% if t.wavDownload %}<a href="{{ t.wavDownload }}" download>download wavs</a>{% endif %}
  {% if t.bandcamp %}<a href="{{ t.bandcamp }}" rel="noopener">bandcamp</a>{% endif %}
  {% if t.soundcloud %}<a href="{{ t.soundcloud }}" rel="noopener">soundcloud</a>{% endif %}
</div>
{% endif %}

{% if t.notes %}
<section class="tape-notes" aria-labelledby="notes-key">
  <h2 class="notes-key" id="notes-key">notes on this tape</h2>
  <div class="notes-body">{{ t.notes | prose | safe }}</div>
</section>
{% endif %}

{% if t.media %}
<div class="media-flow">
  {% for item in t.media %}
  {% set capNo = loop.index | pad2 %}

    {% if item.type == "embed" %}
      {# a share url from spotify / youtube / vimeo / apple music / soundcloud #}
      {% set frame = item | embedInfo %}
      {% if frame.src %}
      <figure class="media-card">
        <div class="media-embed"
             style="{% if frame.height %}height: {{ frame.height }}px{% else %}aspect-ratio: {{ frame.ratio or '16 / 9' }}{% endif %}">
          <iframe src="{{ frame.src }}"
                  title="{{ item.label or 'embedded player' }}"
                  loading="lazy"
                  allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                  allowfullscreen></iframe>
        </div>
        {{ cap.caption(item, capNo) }}
      </figure>
      {% else %}
      {# url we can't frame — a plain link beats an empty box #}
      <a class="media-link" href="{{ item.url }}" rel="noopener">{{ item.label or item.url }}<span aria-hidden="true">&#8599;</span></a>
      {% endif %}

    {% elif item.type == "video" %}
      {% set poster = item.poster | mediaSrc(t.slug) %}
      <figure class="media-card">
        <video class="media-video"
               src="{{ item.src | mediaSrc(t.slug) }}"
               {% if poster %}poster="{{ poster }}"{% endif %}
               {% if item.ratio %}style="aspect-ratio: {{ item.ratio }}"{% endif %}
               controls preload="metadata" playsinline></video>
        {{ cap.caption(item, capNo) }}
      </figure>

    {% elif item.type == "link" %}
      <a class="media-link" href="{{ item.url }}" rel="noopener">{{ item.label or item.url }}<span aria-hidden="true">&#8599;</span></a>

    {% elif item.src %}
      {# photos and paintings keep their own proportions — no forced box #}
      {% set src = item.src | mediaSrc(t.slug) %}
      {% set set = src | cdnSet([640, 960, 1280, 1600]) %}
      {% set ar = src | aspect %}
      <figure class="media-card media-card--img"{% if ar %} style="--ar: {{ ar }}"{% endif %}>
        <img class="media-img" src="{{ src | cdn(1280) }}"
             {% if set %}srcset="{{ set }}" sizes="(max-width: 860px) 100vw, 800px"{% endif %}
             alt="{{ item.alt or item.label or '' }}"
             {% if ar %}width="{{ src | pixelWidth }}" height="{{ src | pixelHeight }}"{% endif %}
             loading="lazy" decoding="async" />
        {{ cap.caption(item, capNo) }}
      </figure>
    {% endif %}

  {% endfor %}
</div>
{% endif %}

<div class="tape-pagination">
  {% tapeNav collections.tapes, t.tapeNumber %}
</div>

<div class="forward-note">
  sent this to a friend? <a href="/about/#join">join the list</a> to get the next one.
</div>

<audio id="player" preload="none"></audio>
<script src="/js/deck.js" defer></script>
