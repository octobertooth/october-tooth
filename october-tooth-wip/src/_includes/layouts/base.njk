<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title or "october tooth" }}</title>
    {% if noindex %}<meta name="robots" content="noindex, nofollow" />{% endif %}
    <meta name="theme-color" content="#c3ccd5" />
    <link rel="stylesheet" href="/css/main.css" />
  </head>
  <body>
    <div class="page">
      <div class="titlebar">
        <span class="titlebar-lights" aria-hidden="true">
          <span class="tl tl--red"></span><span class="tl tl--amber"></span><span class="tl tl--green"></span>
        </span>
        <a class="titlebar-name" href="/">october tooth</a>
        <span class="titlebar-sub" aria-hidden="true">practice tapes</span>
      </div>

      <nav class="site-nav" aria-label="sections">
        <a href="/"{% if page.url == "/" %} class="is-here" aria-current="page"{% endif %}>current tape</a>
        <a href="/archive/"{% if page.url == "/archive/" %} class="is-here" aria-current="page"{% endif %}>archive</a>
        <a href="/about/"{% if page.url == "/about/" %} class="is-here" aria-current="page"{% endif %}>about</a>
      </nav>

      <main class="page-body">
        {{ content | safe }}
      </main>

      <div class="site-footer">
        <a href="/">october tooth</a>
        <a href="/archive/">archive</a>
        <a href="/about/">about</a>
      </div>
    </div>
  </body>
</html>
